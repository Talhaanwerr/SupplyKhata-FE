# ─── Public (safe to expose to the browser) ───────────────────────────────────
# NEVER put private secrets, DB URLs, JWT signing keys, or API private keys here.
# NEXT_PUBLIC_APP_URL and NEXT_PUBLIC_API_URL are required — no localhost fallback in code.
NEXT_PUBLIC_APP_NAME="SupplyKhata"
NEXT_PUBLIC_APP_URL="http://localhost:3010"
# Local: point at Nest directly. Live (Vercel): use SAME origin as the FE so cookies work:
#   NEXT_PUBLIC_API_URL="https://your-app.vercel.app/api/v1"
NEXT_PUBLIC_API_URL="http://localhost:4700/api/v1"

# ─── Server-only (Vercel / Next rewrites) ─────────────────────────────────────
# Real Nest origin on Railway. Enables /api/v1/* → Railway proxy (first-party cookies).
# Leave unset locally. Do NOT put /api/v1 on the end.
# API_BACKEND_URL="https://your-be.up.railway.app"

# AUTH_SECRET is intentionally omitted from the browser bundle — keep secrets
# on the NestJS backend (.env), not in this frontend app.
